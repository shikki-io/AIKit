.build/
.swiftpm/
# kagami runner scratch — SQLite history is per-machine state, never tracked
.kagami/*.sqlite
.kagami/*.sqlite-shm
.kagami/*.sqlite-wal
.kagami/*.db
.kagami/*.db-shm
.kagami/*.db-wal
.kagami/*.write-lock
# Secrets — env files and every backup of them never belong in git.
# A backup is git history, not a copy next to the file.
.env
.env.*
*.env
*.env.bak*
*.env.back*
!.env.example
!.env.template
!.env.sample
!.env.dist
!*.env.example
!*.env.template
